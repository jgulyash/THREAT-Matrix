#!/usr/bin/env bash
#
# THREAT Matrix pre-commit hook.
#
# What it does, in order:
#
#   1. Decides whether this commit needs checking. It does when any staged
#      path is under docs/data/, src/, scripts/, examples/, docs/assets/, or
#      .github/workflows/, or is index.html, docs/index.html, package.json,
#      bun.lock, vite.config.ts, or a tsconfig*.json file. That covers every
#      gated document, every viewer build input, and every build output.
#      Otherwise it exits 0 at once.
#   2. Exports the STAGED content (the git index) to a temporary directory
#      and runs every check there. The working tree is never linted, so
#      what is checked is exactly what will be committed.
#   3. Runs the gate commands (the same commands CI runs):
#        validate.py (plain, with the overlay, the fixture harness, and the
#        scored worked cases), field-parity.py, mesh-refs.py,
#        id-manifest.py --check, consumer-smoke.py,
#        derive-axis-confidence.py --check.
#      JSON Schema validation is required: the jsonschema package must be
#      installed, and the hook fails with a clear message if it is not.
#      id-manifest.py --check also compares against the committed published
#      baseline (docs/data/baselines/id-manifest-1.7.0.json) and against the
#      manifest in the previous commit (HEAD), so an ID cannot be dropped or
#      reused by regenerating the manifest in the same commit.
#      The fixture harness is the slow gate (it re-validates the document
#      once per fixture), so it runs only when the validator, a fixture, or
#      a schema is staged (scripts/lint/ or docs/data/*.schema.json). CI
#      always runs it.
#   4. Bundle rule. If a viewer build input is staged (anything under src/,
#      index.html, package.json, bun.lock, vite.config.ts, tsconfig*.json,
#      or a docs/data file the viewer imports), then a rebuilt bundle must
#      be staged too: at least one added or modified file under
#      docs/assets/, and docs/index.html.
#   5. Checks, on every checked commit, that the staged docs/index.html
#      references exactly the files in the staged docs/assets/.
#
# It does not run the viewer build. CI rebuilds and compares.
#
# Install (run once, from the repository root):
#   git config core.hooksPath scripts/git-hooks
#
# Bypass (avoid): git commit --no-verify. CI runs the same gates on every
# push and pull request for main, v1-build, and v3-design.

set -eu

fail() {
  printf '\npre-commit FAILED: %s\n' "$1" >&2
  shift
  for line in "$@"; do
    printf '  %s\n' "$line" >&2
  done
  printf '\n' >&2
  exit 1
}

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

work="$(mktemp -d "${TMPDIR:-/tmp}/tm-precommit.XXXXXX")"
cleanup() {
  # Remove only the directory this run created with mktemp.
  case "$work" in
    */tm-precommit.??????)
      if [ -d "$work" ]; then
        rm -rf -- "$work"
      fi
      ;;
  esac
}
trap cleanup EXIT

# ---- 1. Which staged paths matter -----------------------------------------
# NUL-delimited list written to a file, then read back: no pipeline, so no
# early-exit reader can make a writer fail and skip the checks.
git diff --cached --name-only -z > "$work/staged.list"

trigger=false
bundle_input=false
harness_needed=false
data_paths=()
while IFS= read -r -d '' path; do
  case "$path" in
    docs/data/*|src/*|scripts/*|examples/*|index.html|package.json|\
    bun.lock|vite.config.ts|tsconfig*.json|docs/index.html|docs/assets/*|\
    .github/workflows/*)
      trigger=true
      ;;
  esac
  case "$path" in
    scripts/lint/*|docs/data/*.schema.json)
      harness_needed=true
      ;;
  esac
  case "$path" in
    src/*|index.html|package.json|bun.lock|vite.config.ts|tsconfig*.json)
      bundle_input=true
      ;;
    docs/data/*)
      data_paths+=("$path")
      ;;
  esac
done < "$work/staged.list"

if [ "$trigger" != "true" ]; then
  exit 0
fi

# ---- 2. Export the staged tree ---------------------------------------------
tree="$work/tree"
mkdir "$tree"
git checkout-index --all --prefix="$tree/"

# A staged docs/data file is a build input when the staged viewer source
# imports it by name.
if [ "${#data_paths[@]}" -gt 0 ] && [ -d "$tree/src" ]; then
  for path in "${data_paths[@]}"; do
    base="${path##*/}"
    if grep -rqF -- "data/$base" "$tree/src"; then
      bundle_input=true
    fi
  done
fi

# ---- 3. Gate commands, run against the staged tree --------------------------
if ! command -v python3 >/dev/null 2>&1; then
  fail "python3 is not installed" \
    "The gates need Python 3. Install it, or commit with --no-verify and" \
    "let CI run the gates."
fi

run_gate() {
  # run_gate "label" command args...
  label="$1"
  shift
  if ! ( cd "$tree" && "$@" ); then
    fail "$label" \
      "The check above ran against the STAGED content, not the working tree." \
      "Fix the problem, stage the fix with git add, and commit again."
  fi
}

for required in docs/data/framework.json docs/data/scoring-overlay.json docs/data/id-manifest.json; do
  if [ ! -f "$tree/$required" ]; then
    fail "$required is not in the staged tree" \
      "Every commit must carry the framework, the overlay, and the ID manifest."
  fi
done

if ! python3 -c 'import jsonschema, referencing' >/dev/null 2>&1; then
  fail "the jsonschema package is not installed" \
    "JSON Schema validation is a required gate and cannot be skipped." \
    "Install it with: python3 -m pip install 'jsonschema==4.26.0'" \
    "(version 4.18 or later works; CI uses 4.26.0)."
fi

run_gate "validate (framework)" \
  python3 scripts/lint/validate.py docs/data/framework.json --require-schema
run_gate "validate (framework + overlay)" \
  python3 scripts/lint/validate.py docs/data/framework.json --overlay docs/data/scoring-overlay.json --require-schema
if [ "$harness_needed" = "true" ]; then
  run_gate "validate (fixture harness)" \
    python3 scripts/lint/validate.py docs/data/framework.json --fixtures scripts/lint/fixtures
else
  printf '%s\n' "pre-commit: fixture harness not run (no validator, fixture, or schema change staged); CI runs it."
fi
run_gate "validate (scored worked cases)" \
  python3 scripts/lint/validate.py docs/data/framework.json --overlay docs/data/scoring-overlay.json --records examples/experimental-scoring/worked-cases --require-schema
run_gate "field-parity" \
  python3 scripts/lint/field-parity.py docs/data/framework.json
run_gate "mesh-refs" \
  python3 scripts/lint/mesh-refs.py docs/data/framework.json
# Baselines: the committed published baseline, and the manifest as it is in
# the previous commit. Both must still be honored by the staged manifest.
manifest_args=(--check docs/data/framework.json docs/data/id-manifest.json)
if [ -f "$tree/docs/data/baselines/id-manifest-1.7.0.json" ]; then
  manifest_args+=(--baseline docs/data/baselines/id-manifest-1.7.0.json)
else
  fail "docs/data/baselines/id-manifest-1.7.0.json is not in the staged tree" \
    "The published ID baseline must stay committed; it is what proves that no" \
    "published identifier was dropped or reused."
fi
if git cat-file -e HEAD:docs/data/id-manifest.json 2>/dev/null; then
  git show HEAD:docs/data/id-manifest.json > "$work/previous-id-manifest.json"
  manifest_args+=(--baseline "$work/previous-id-manifest.json")
fi
run_gate "id-manifest" \
  python3 scripts/lint/id-manifest.py "${manifest_args[@]}"
run_gate "axis-confidence" \
  python3 scripts/analysis/derive-axis-confidence.py --check

run_gate "consumer-smoke" \
  python3 scripts/lint/consumer-smoke.py

# ---- 4. Bundle rule ----------------------------------------------------------
if [ "$bundle_input" = "true" ]; then
  # --no-renames: a rebuilt bundle that differs only slightly from the old one
  # is otherwise reported as a rename (R), which the AM filter would miss.
  git diff --cached --no-renames --name-only -z --diff-filter=AM -- docs/assets > "$work/assets.list"
  assets_staged=false
  if [ -s "$work/assets.list" ]; then
    assets_staged=true
  fi
  index_staged=false
  if ! git diff --cached --quiet --diff-filter=AM -- docs/index.html; then
    index_staged=true
  fi
  if [ "$assets_staged" != "true" ] || [ "$index_staged" != "true" ]; then
    fail "bundle is not staged with its inputs" \
      "A viewer build input is staged (src/, index.html, package.json, bun.lock," \
      "vite.config.ts, tsconfig, or a docs/data file the viewer imports), but the" \
      "rebuilt bundle is not fully staged:" \
      "  docs/assets/ (added or modified file): $([ "$assets_staged" = "true" ] && echo staged || echo MISSING)" \
      "  docs/index.html:                       $([ "$index_staged" = "true" ] && echo staged || echo MISSING)" \
      "To fix:" \
      "  rm -f docs/assets/index-*" \
      "  bun run build" \
      "  git add -A docs/assets docs/index.html"
  fi
fi

# ---- 5. index.html and assets agree, in the staged tree ---------------------
# Always run: a missing docs/index.html or docs/assets is itself a failure.
run_gate "bundle references" \
  python3 scripts/git-hooks/check-bundle-refs.py .

printf 'pre-commit PASSED: all gates ran against the staged content.\n'
exit 0
